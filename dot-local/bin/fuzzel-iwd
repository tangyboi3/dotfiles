#!/bin/sh

	delim=$(printf '\037')

pickssid () {
	iwctl station wlan0 scan
	conn=$(iwctl station wlan0 show | grep 'Connected ' | sed -E "s/ {2,}/$delim/g; s/^$delim//" | cut -d $delim -f 2)
	scan=$(iwctl station wlan0 get-networks rssi-dbms | tail -n +6 | head -n -1 | sed -E "s/ {2,}/$delim/g; s/^$delim//" | sort -t $delim -k 3,3)
	ssids=$(echo "Reload"; echo "* $conn"; printf '%b' "$scan" | cut -d $delim -f 1)

	ssidpick=$(echo "$ssids" | fuzzel --dmenu "$@" --placeholder "iwd-wifi" --minimal-lines -w 20)
	if [ -z "$ssidpick" ]; then
		exit 1
	elif [ "$ssidpick" = "Reload" ]; then
		pickssid "$@"
	elif [ "$ssidpick" = ">$conn" ]; then
		actions="Disconnect\nForget\nBack\n"
	elif [ "$(iwctl known-networks list | grep -wc "$ssidpick")" -ge 1 ]; then
		actions="Connect\nForget\nBack\n"
	else
		actions="Passphrase\nBack\n"
	fi
}

pickaction () {
	actionpick=$(printf '%b' "$actions" | fuzzel --dmenu "$@" --placeholder "$ssidpick" --minimal-lines -w 20)
	case $actionpick in
		*"Connect")
			iwctl station wlan0 connect "$ssidpick";;
		*"Disconnect")
			iwctl station wlan0 disconnect;;
		*"Forget")
			confirm=$(printf '%b' "Yes\nNo" | fuzzel --dmenu "$@" --placeholder "Confirm?" -l 2)
			if [ "$confirm" = "Yes" ]; then
				iwctl known-networks "$ssidpick" forget
			else
				pickaction "$@"
			fi;;
		*"Passphrase")
			sec=$(echo "$scan" | grep "$ssidpick" | cut -f 2)
			if [ "$sec" = "open" ]; then
				iwctl station wlan0 connect "$ssidpick"
			else
				pass=$(echo Back | fuzzel --dmenu "$@" --password -l 1)
				[ "$pass" = "Back" ] && pickaction "$@"
				iwctl --passphrase "$pass" station wlan0 connect "$ssidpick"
			fi;;
		*"Back")
			pickssid "$@" && pickaction "$@";;
		"")
			exit 1;;
	esac
}

killall fuzzel
pickssid "$@" && pickaction "$@"
