#!/bin/sh

yn=$(echo "Yes"; echo "No")

pickssid () {
	iwctl station wlan0 scan
	conn=$(iwctl station wlan0 show | grep 'Connected ' | sed 's/.*Connected network *//')
	# remove colorcodes and replace 2+ spaces with tabs
	scan=$(iwctl station wlan0 get-networks rssi-dbms | tail -n +5 | sed -E 's/\x1B\[[0-9;]*[JKmsu]//g; s/\s{2,}/\t/g; s/^\s//')
	# sort by dBm
	ssids=$(echo "Reload"; echo "$conn"; echo "$scan" | awk -F'\t' '$1 !~ />/ { print $3"\t"$1 }' | sort | cut -f 2-)

	ssidpick=$(echo "$ssids" | fuzzel --dmenu "$@" --placeholder "$conn" -l "$(echo "$ssids" | wc -l)")
	if [ -z "$ssidpick" ]; then
		exit 1
	elif [ "$ssidpick" = "Reload" ]; then
		pickssid
	elif [ "$ssidpick" = "$conn" ]; then
		actions="Disconnect\nForget\nBack\n"
	elif [ "$(iwctl known-networks list | grep -wc "$ssidpick")" -ge 1 ]; then
		actions="Connect\nForget\nBack\n"
	else
		actions="Passphrase\nBack\n"
	fi
}

pickaction () {
	actionpick=$(printf '%b' $actions | fuzzel --dmenu "$@" --placeholder "$ssidpick" -l "$(printf '%b' $actions | wc -l)")
	case $actionpick in
		*"Connect")
			iwctl station wlan0 connect "$ssidpick";;
		*"Disconnect")
			iwctl station wlan0 disconnect;;
		*"Forget")
			confirm=$(echo "$yn" | fuzzel --dmenu "$@" --placeholder "Confirm?" -l 2)
			if [ "$confirm" = "Yes" ]; then
				iwctl known-networks "$ssidpick" forget
			else
				pickaction
			fi;;
		*"Passphrase")
			sec=$(echo "$scan" | grep "$ssidpick" | cut -f 2)
			if [ "$sec" = "open" ]; then
				iwctl station wlan0 connect "$ssidpick"
			else
				pass=$(echo Back | fuzzel --dmenu "$@" --password -l 1)
				[ "$pass" = "Back" ] && pickaction
				iwctl --passphrase "$pass" station wlan0 connect "$ssidpick"
			fi;;
		*"Back")
			pickssid && pickaction;;
		"")
			exit 1;;
	esac
}

killall fuzzel
pickssid && pickaction
