#!/bin/bash

cpu=$(vmstat | awk '/[0-9]/ { print $13 }')
memgb=$(free -g | awk '/Mem/ { print $3 }')
memp=$(free | awk '/Mem/ { print int($3/$2*10+.5) }')
disk=$(df | awk '/^\/dev/ { print $5; exit }' | tr -d "%")

# while : ; do
	echo "cpu|range:0-100|$cpu"
	echo "memgb|int|$memgb"
	echo "memp|range:0-100|$memp"
	echo "disk|range:0-100|$disk"
	echo
	# sleep 10
# done
