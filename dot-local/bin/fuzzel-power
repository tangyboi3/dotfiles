#!/bin/sh

killall fuzzel
pick=$(printf "󰤄 Sleep\n Hibernate\n Restart\n Shutdown\n󰍃 Logout" | fuzzel --dmenu "$@" -w 15 --minimal-lines)
[ -z $pick ] && exit 1

case $pick in
	*"Logout")
		swaymsg exit;;
	*"Sleep")
		systemctl suspend;;
	*"Hibernate")
		systemctl hibernate;;
	*"Restart")
		systemctl reboot;;
	*"Shutdown")
		systemctl poweroff;;
esac
