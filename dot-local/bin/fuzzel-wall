#!/bin/sh

killall fuzzel
dir="$HOME/.local/share/wallpapers"

img=$(ls "$dir" | fuzzel --dmenu "$@" -l $(ls "$dir" | wc -l))
[ -z "$img" ] && exit 1
back=$(printf "colorz\nfast_colorthief\nhaishoku\nwal" | fuzzel --dmenu "$@" -l 4)
[ -z "$back" ] && exit 1
cols16=$(printf "only 8\nlight 16\ndark 16" | fuzzel --dmenu "$@" -l 3)
[ -z "$cols16" ] && exit 1

case $cols16 in
  "only"*)
    wal -q -i "$dir"/"$img" --backend "$back";;
  "light"*)
    wal -q -i "$dir"/"$img" --backend "$back" --cols16 lighten;;
  "dark"*)
    wal -q -i "$dir"/"$img" --backend "$back" --cols16 darken;;
esac
