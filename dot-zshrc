HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
setopt autocd extendedglob nomatch notify
bindkey -v

autoload -Uz compinit
compinit

zstyle ':completion:*' menu select

PROMPT='%B%(?..[%?] )%b%n@%U%m%u> '
RPROMPT="%F{green}%~%f"
if [ -n "$YAZI_LEVEL" ]; then
    PROMPT="$(echo $PROMPT | sed s/u/u:yazi/)"
fi

y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
	    builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

ssh() {
    command ssh "$@"
    local ssh_status=$?
    source ~/.zshrc
    return $ssh_status
}

alias ls="ls --color=auto"
alias grep="grep --color=auto"
alias logout="loginctl terminate-user tangy"
alias yambar="yambar-wal"
alias hx="helix"

(cat ~/.cache/wal/sequences &)

[ -f "/home/tangy/.ghcup/env" ] && . "/home/tangy/.ghcup/env" # ghcup-env
